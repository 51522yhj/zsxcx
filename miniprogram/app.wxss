page {
  background: #f7f7f7;
  color: #222222;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.product-card {
  width: calc((100% - 28rpx) / 3);
  background: #ffffff;
  border: 1rpx solid #eeeeee;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.05);
}

.product-card image {
  display: block;
  width: 100%;
  height: 194rpx;
  background: #f1f1f1;
}

.product-info {
  min-height: 116rpx;
  padding: 14rpx 14rpx 16rpx;
  box-sizing: border-box;
}

.product-name {
  color: #333333;
  font-size: 30rpx;
  line-height: 1.25;
  word-break: break-all;
}

.product-meta {
  margin-top: 8rpx;
  color: #888888;
  font-size: 28rpx;
  line-height: 1.25;
  word-break: break-all;
}

.no-image-text {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-size: 24rpx;
  background: rgba(246, 246, 246, 0.72);
}

@keyframes imageLoading {
  0% { background-position: 120% 0; }
  100% { background-position: -120% 0; }
}

button::after {
  border: 0;
}
