<view class="category-page">
  <view class="top-search">
    <input value="{{keyword}}" placeholder="搜索" bindinput="input" confirm-type="search" bindconfirm="search" />
  </view>

  <view class="body">
    <scroll-view scroll-y class="side">
      <view
        wx:for="{{sideItems}}"
        wx:key="name"
        class="side-item level-{{item.level}} {{activeCategoryId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        data-type="{{item.type}}"
        bindtap="selectCategory"
      >
        <text wx:if="{{item.level === 1}}" class="child-dot"></text>
        <text>{{item.name}}</text>
      </view>
    </scroll-view>

    <scroll-view scroll-y class="content">
      <view class="list">
        <view class="row" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
          <view class="row-img">
            <image class="placeholder" src="/assets/ui/image-placeholder.png" mode="aspectFill" />
            <image
              class="real-image"
              wx:if="{{item.displayImageUrl}}"
              data-src="{{item.rawImageUrl}}"
              src="{{item.displayImageUrl}}"
              mode="aspectFill"
              lazy-load
              binderror="imageError"
            />
          </view>
          <view class="row-info">
            <view class="row-name">{{item.name}}</view>
            <view class="row-summary">{{item.summary || '价格面议'}}</view>
          </view>
        </view>
      </view>

      <view class="empty" wx:if="{{!products.length}}">
        <image src="/assets/ui/empty-box.png" mode="aspectFit" />
        <view>该分类下暂无相关内容</view>
      </view>
    </scroll-view>
  </view>
</view>
