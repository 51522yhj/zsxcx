<view class="category-page">
  <view class="top-search" bindtap="goSearch">
    <view class="search-entry">搜索</view>
  </view>

  <view class="body">
    <scroll-view scroll-y class="side">
      <view
        wx:for="{{sideItems}}"
        wx:key="name"
        class="side-item level-{{item.level}} {{activeCategoryId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        data-type="{{item.type}}"
        bindtap="selectCategory"
      >
        <text wx:if="{{item.level === 1}}" class="child-dot"></text>
        <text>{{item.name}}</text>
      </view>
    </scroll-view>

    <scroll-view scroll-y class="content" lower-threshold="120" bindscrolltolower="loadMoreProducts">
      <view class="list">
        <view class="row" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
          <view class="row-img">
            <image class="placeholder" src="/assets/ui/image-placeholder.png" mode="aspectFill" />
            <view class="no-image-text" wx:if="{{!item.displayImageUrl}}">暂无图片</view>
            <image
              class="real-image"
              wx:if="{{item.displayImageUrl}}"
              data-src="{{item.rawImageUrl}}"
              src="{{item.displayImageUrl}}"
              mode="aspectFill"
              lazy-load
              binderror="imageError"
            />
          </view>
          <view class="row-info">
            <view class="row-name">{{item.name}}</view>
            <view class="row-summary" wx:if="{{item.summary}}">{{item.summary}}</view>
          </view>
        </view>
      </view>

      <view class="empty" wx:if="{{!loading && !products.length}}">
        <image src="/assets/ui/empty-box.png" mode="aspectFit" />
        <view>该分类下暂无相关内容</view>
      </view>
      <view class="loading" wx:if="{{loading}}">加载中...</view>
      <view class="loading" wx:if="{{!loading && finished && products.length}}">已经到底了</view>
    </scroll-view>
  </view>
</view>
