.detail {
  min-height: 100vh;
  padding-bottom: calc(122rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
}

.gallery,
.gallery-media {
  width: 100%;
  height: 690rpx;
  background: #f1f1f1;
}

.gallery-video {
  display: block;
}

.main {
  margin: -1rpx 0 0;
  padding: 36rpx 30rpx 38rpx;
  background: #ffffff;
}

.brand-tag {
  display: inline-flex;
  height: 44rpx;
  align-items: center;
  padding: 0 18rpx;
  margin-bottom: 22rpx;
  border-radius: 22rpx;
  background: #fff0f0;
  color: #ff2d2d;
  font-size: 24rpx;
}

.code {
  color: #333333;
  font-size: 34rpx;
  line-height: 1.4;
}

.price {
  margin-top: 28rpx;
  color: #000000;
  font-size: 52rpx;
  line-height: 1.2;
}

.muted {
  margin-top: 42rpx;
  color: #222222;
  font-size: 28rpx;
}

.graphic-title {
  height: 108rpx;
  background: #f7f7f7;
  color: #666666;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  font-size: 30rpx;
}

.graphic-title view {
  width: 76rpx;
  height: 2rpx;
  background: #d8d8d8;
}

.description {
  padding: 28rpx 30rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.7;
}

.detail-img {
  display: block;
  width: calc(100% - 48rpx);
  margin: 0 24rpx 24rpx;
  background: #f1f1f1;
  border-radius: 8rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: #ffffff;
  box-shadow: 0 -4rpx 18rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.action-bar button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: #ffffff;
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 112rpx;
  height: 112rpx;
  min-width: 0;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
}

.bar-item {
  flex: 0 0 28%;
  border-right: 1rpx solid #eeeeee;
}

.bar-service {
  flex: 1 1 44%;
  background: #ff2d2d !important;
  color: #ffffff !important;
  font-weight: 700;
}

.detail-skeleton {
  min-height: 100vh;
  padding: 0 30rpx;
  background: #f7f7f7;
  box-sizing: border-box;
}

.skeleton {
  background: linear-gradient(90deg, #eeeeee 0%, #f8f8f8 45%, #eeeeee 90%);
  background-size: 240% 100%;
  animation: skeletonLoading 1.2s ease-in-out infinite;
}

.gallery-skeleton {
  width: calc(100% + 60rpx);
  height: 690rpx;
  margin-left: -30rpx;
}

.line {
  height: 34rpx;
  margin-top: 30rpx;
  border-radius: 18rpx;
}

.line.wide {
  width: 72%;
}

.line:not(.wide) {
  width: 46%;
}

.block {
  height: 360rpx;
  margin-top: 42rpx;
  border-radius: 16rpx;
}

@keyframes skeletonLoading {
  0% { background-position: 120% 0; }
  100% { background-position: -120% 0; }
}
