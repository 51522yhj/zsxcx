<view class="detail" wx:if="{{product}}">
  <swiper class="gallery" indicator-dots circular autoplay="{{carouselAutoplay}}" interval="{{carouselInterval}}" bindchange="swiperChange">
    <swiper-item wx:for="{{displayMedia}}" wx:key="imageUrl">
      <video
        wx:if="{{item.mediaType === 'VIDEO'}}"
        id="{{item.videoId}}"
        class="gallery-media gallery-video"
        src="{{item.rawImageUrl}}"
        poster="{{item.posterUrl}}"
        autoplay="{{false}}"
        muted="{{index !== currentIndex}}"
        controls="{{true}}"
        show-progress="{{true}}"
        object-fit="cover"
      />
      <image wx:else class="gallery-media" src="{{item.imageUrl}}" data-url="{{item.rawImageUrl || item.imageUrl}}" mode="aspectFill" bindtap="previewGalleryImage" />
    </swiper-item>
  </swiper>

  <view class="main">
    <view class="brand-tag">{{settings.siteName || '源创潮牌'}}</view>
    <view class="code">{{product.name}}</view>
    <view class="price" wx:if="{{product.summary}}">{{product.summary}}</view>
    <view class="muted">暂无评价</view>
  </view>

  <view class="graphic-title">
    <view></view>
    <text>图文详情</text>
    <view></view>
  </view>

  <view class="description">{{product.description || '暂无详细说明，可点击客服咨询。'}}</view>
  <image wx:for="{{detailImages}}" wx:key="imageUrl" class="detail-img" src="{{item.imageUrl}}" data-url="{{item.rawImageUrl || item.imageUrl}}" mode="widthFix" bindtap="previewDetailImage" />

  <view class="action-bar safe-bottom">
    <button class="bar-item" bindtap="goHome">首页</button>
    <button class="bar-item" open-type="share">分享</button>
    <button class="bar-service" open-type="contact" show-message-card="true" send-message-title="{{product.name}}" send-message-path="/pages/detail/detail?id={{product.id}}" send-message-img="{{messageImageUrl}}">
      客服
    </button>
  </view>
</view>

<view class="detail-skeleton" wx:else>
  <view class="skeleton gallery-skeleton"></view>
  <view class="skeleton line wide"></view>
  <view class="skeleton line"></view>
  <view class="skeleton block"></view>
</view>
