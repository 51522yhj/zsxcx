<view class="search-page">
  <view class="search-panel">
    <view class="search-box">
      <input value="{{keyword}}" placeholder="搜索名称、标签、分类" bindinput="input" confirm-type="search" bindconfirm="search" />
      <button bindtap="search">搜索</button>
    </view>

    <view class="filter-row">
      <view class="filter-label">分类</view>
      <scroll-view scroll-x class="filter-strip">
        <view class="category-chip {{!activeCategoryId ? 'active' : ''}}" data-id="" bindtap="selectCategory">全部</view>
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="category-chip {{activeCategoryId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectCategory"
        >{{item.name}}</view>
      </scroll-view>
    </view>

    <view class="filter-row" wx:if="{{tags.length}}">
      <view class="filter-label">标签</view>
      <scroll-view scroll-x class="filter-strip">
        <view
          wx:for="{{tags}}"
          wx:key="id"
          class="tag-chip {{activeTagId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectTag"
        >{{item.name}}</view>
      </scroll-view>
    </view>
  </view>

  <view class="result-head">
    <text>商品列表</text>
    <text wx:if="{{products.length}}">{{products.length}} 款</text>
    <text wx:elif="{{searched}}">暂无结果</text>
    <text wx:else>选择分类或输入关键词</text>
  </view>

  <view class="product-grid search-grid" wx:if="{{products.length}}">
    <view class="product-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="image-wrap">
        <image class="placeholder" src="/assets/ui/image-placeholder.png" mode="aspectFill" />
        <view class="no-image-text" wx:if="{{!item.displayImageUrl}}">暂无图片</view>
        <image
          class="real-image"
          wx:if="{{item.displayImageUrl}}"
          data-src="{{item.rawImageUrl}}"
          src="{{item.displayImageUrl}}"
          mode="aspectFill"
          lazy-load
          binderror="imageError"
        />
      </view>
      <view class="product-info">
        <view class="product-name">{{item.name}}</view>
        <view class="product-meta" wx:if="{{item.summary}}">{{item.summary}}</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{searched && !products.length}}">
    <image src="/assets/ui/empty-box.png" mode="aspectFit" />
    <view>没有找到相关商品</view>
  </view>
</view>
