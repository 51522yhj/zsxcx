.search-page {
  min-height: 100vh;
  padding: 20rpx 24rpx 34rpx;
  background: #f7f7f7;
  box-sizing: border-box;
}

.search-panel {
  padding: 18rpx 0 10rpx;
}

.search-box {
  height: 76rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-box input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 38rpx;
  background: #ffffff;
  color: #222222;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-box button {
  width: 126rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 38rpx;
  background: #ff2d2d;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
}

.history {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #222222;
  font-size: 26rpx;
  font-weight: 700;
}

.history-clear {
  color: #999999;
  font-weight: 400;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.history-chip {
  max-width: 240rpx;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: #f7f7f7;
  color: #555555;
  font-size: 26rpx;
  line-height: 54rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.filter-label {
  width: 72rpx;
  height: 44rpx;
  margin-right: 10rpx;
  border-radius: 22rpx;
  background: #fff0f0;
  color: #ff2d2d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex: none;
}

.filter-strip {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.category-chip,
.tag-chip,
.sort-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  max-width: 190rpx;
  padding: 0 24rpx;
  margin-right: 14rpx;
  border-radius: 30rpx;
  background: #ffffff;
  color: #555555;
  font-size: 26rpx;
  line-height: 58rpx;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-chip {
  border: 1rpx solid #eeeeee;
}

.category-chip.active,
.tag-chip.active,
.sort-chip.active {
  background: #ff2d2d;
  border-color: #ff2d2d;
  color: #ffffff;
  font-weight: 700;
}

.result-head {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #222222;
  font-size: 30rpx;
  font-weight: 700;
}

.result-head text:last-child {
  color: #888888;
  font-size: 24rpx;
  font-weight: 400;
}

.search-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  width: 100%;
  box-sizing: border-box;
}

.search-grid .product-card {
  width: 100%;
  min-width: 0;
  border-radius: 12rpx;
}

.image-wrap {
  position: relative;
  width: 100%;
  height: 330rpx;
  background: linear-gradient(90deg, #f1f1f1 0%, #fafafa 45%, #f1f1f1 90%);
  background-size: 240% 100%;
  animation: imageLoading 1.2s ease-in-out infinite;
  overflow: hidden;
}

.image-wrap image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.placeholder {
  z-index: 1;
}

.real-image {
  z-index: 2;
}

.search-grid .product-info {
  min-height: 138rpx;
  padding: 18rpx 20rpx 20rpx;
}

.search-grid .product-name {
  font-size: 30rpx;
  line-height: 1.35;
}

.search-grid .product-meta {
  margin-top: 18rpx;
  color: #888888;
  font-size: 32rpx;
  font-weight: 500;
}

.skeleton-grid {
  pointer-events: none;
}

.skeleton-card {
  min-height: 470rpx;
  overflow: hidden;
  background: #ffffff;
}

.skeleton {
  background: linear-gradient(90deg, #eeeeee 0%, #f8f8f8 45%, #eeeeee 90%);
  background-size: 240% 100%;
  animation: imageLoading 1.2s ease-in-out infinite;
}

.skeleton-img {
  width: 100%;
  height: 330rpx;
}

.skeleton-line {
  width: 76%;
  height: 28rpx;
  margin: 24rpx 20rpx 0;
  border-radius: 14rpx;
}

.skeleton-line.short {
  width: 48%;
  margin-top: 18rpx;
}

@keyframes imageLoading {
  0% { background-position: 120% 0; }
  100% { background-position: -120% 0; }
}

.empty {
  padding-top: 130rpx;
  color: #777777;
  font-size: 28rpx;
  text-align: center;
}

.empty image {
  width: 220rpx;
  height: 160rpx;
  display: block;
  margin: 0 auto 20rpx;
}

.loading {
  padding: 26rpx 0 36rpx;
  color: #999999;
  font-size: 24rpx;
  text-align: center;
}
