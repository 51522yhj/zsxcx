.mine-page {
  min-height: 100vh;
  padding: 28rpx 24rpx;
  background: #f7f7f7;
  box-sizing: border-box;
}

.brand {
  min-height: 178rpx;
  padding: 30rpx;
  border-radius: 18rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
  border-top: 8rpx solid #ff2d2d;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
}

.brand-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 20rpx;
  background: #ff2d2d;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 800;
  flex: none;
}

.brand-copy {
  min-width: 0;
}

.name {
  color: #202020;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
}

.sub {
  margin-top: 8rpx;
  color: #777777;
  font-size: 25rpx;
  line-height: 1.4;
}

.contact-panel {
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.05);
}

.row {
  min-height: 110rpx;
  padding: 22rpx 26rpx;
  border-bottom: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.label {
  color: #999999;
  font-size: 24rpx;
  line-height: 1.3;
}

.value {
  margin-top: 8rpx;
  color: #222222;
  font-size: 30rpx;
  line-height: 1.35;
  word-break: break-all;
}

.copy {
  width: 96rpx;
  height: 48rpx;
  border-radius: 24rpx;
  border: 1rpx solid #ff2d2d;
  color: #ff2d2d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex: none;
}

.service {
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: #ff2d2d;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 96rpx;
  text-align: center;
}
