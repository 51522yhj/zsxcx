<view class="home">
  <view class="notice" bindtap="openNotice" wx:if="{{noticeText}}">
    <view class="speaker">
      <image class="speaker-icon" src="/assets/ui/speaker.png" mode="aspectFit" />
    </view>
    <text class="notice-brand">{{settings.siteName}}</text>
    <view class="marquee">
      <view class="marquee-text">{{noticeText}}   {{noticeText}}</view>
    </view>
  </view>

  <view class="search" bindtap="goSearch">搜索</view>

  <view wx:for="{{sections}}" wx:key="title" class="section">
    <view class="section-head">
      <view class="line"></view>
      <text>{{item.title}}</text>
      <view class="line"></view>
      <view class="more" wx:if="{{item.products[0].categoryId}}" data-id="{{item.products[0].categoryId}}" bindtap="goCategory">更多 ></view>
    </view>
    <view class="product-grid">
      <view class="product-card" wx:for="{{item.products}}" wx:for-item="product" wx:key="id" data-id="{{product.id}}" bindtap="goDetail">
        <view class="image-wrap">
          <image class="placeholder" src="/assets/ui/image-placeholder.png" mode="aspectFill" />
          <view class="no-image-text" wx:if="{{!product.displayImageUrl}}">暂无图片</view>
          <image
            class="real-image"
            wx:if="{{product.displayImageUrl}}"
            data-src="{{product.rawImageUrl}}"
            src="{{product.displayImageUrl}}"
            mode="aspectFill"
            lazy-load
            binderror="imageError"
          />
        </view>
        <view class="product-info">
          <view class="product-name">{{product.name}}</view>
          <view class="product-meta" wx:if="{{product.summary}}">{{product.summary}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section skeleton-section" wx:if="{{loading && !products.length}}">
    <view class="section-head">
      <view class="line"></view>
      <text>加载中</text>
      <view class="line"></view>
    </view>
    <view class="product-grid">
      <view class="product-card skeleton-card" wx:for="{{skeletonItems}}" wx:key="*this">
        <view class="skeleton skeleton-img"></view>
        <view class="skeleton skeleton-line"></view>
        <view class="skeleton skeleton-line short"></view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !products.length}}">
    <image src="/assets/ui/empty-box.png" mode="aspectFit" />
    <view>暂无商品</view>
  </view>
  <view class="loading" wx:if="{{loading && products.length}}">加载中...</view>

  <view class="modal-mask" wx:if="{{showNotice}}" bindtap="closeNotice">
    <view class="notice-card" catchtap="noop">
      <view class="notice-head">
        <view class="notice-dot">
          <image class="notice-icon" src="/assets/ui/speaker.png" mode="aspectFit" />
        </view>
        <text>{{activeNotice.title || '公告'}}</text>
      </view>
      <scroll-view scroll-y class="notice-body">
        <image wx:if="{{activeNotice.imageUrl}}" class="notice-img" src="{{activeNotice.imageUrl}}" mode="widthFix" />
        <view class="notice-content">{{activeNotice.content}}</view>
      </scroll-view>
      <button class="notice-button" bindtap="closeNotice">我知道了</button>
    </view>
  </view>
  <view class="subscribe-mask"  wx:if="{{showSubscribePrompt}}" >
    <view class="subscribe-card">
      <view class="subscribe-badge">新</view>
      <view class="subscribe-title">开启新品上架提醒</view>
      <view class="subscribe-desc">开启后，新品发布时会通过微信订阅消息提醒你；如微信要求重新授权，可在我的页面再次开启。</view>
      <view class="subscribe-actions">
        <button class="subscribe-cancel" bindtap="skipNewProductNotice">暂不开启</button>
        <button class="subscribe-confirm" bindtap="enableNewProductNotice">开启提醒</button>
      </view>
    </view>
  </view>
</view>
